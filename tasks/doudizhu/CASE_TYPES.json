{
  "game": "doudizhu",
  "engine": "DouZero-WP released weights, mechanism B, PIMC belief",
  "V_definition": "landlord win probability = fraction of sampled deals won by the landlord, where each deal is drawn uniformly from those CONSISTENT with the landlord information set at that state (real landlord hand, real farmer plays, exact farmer counts) and played out greedily (tau=0.00) by the released DouZero-WP networks; 400..4000 sampled deals per state, adaptively refined to push labels past 2 sigma from their band boundary; any that remain inside it are abstained, not guessed. V is a function of what is on screen and NOT itself on screen. Belief model: uniform over count-consistent deals; the standard PIMC limitation is that this ignores inference from the action history.",
  "information_set": "landlord: own hand + bottom three + all plays + both farmer card counts. The two farmer hands are face DOWN in the video and are never revealed.",
  "tiers": "T1 = the move (player, move_type, num_cards) at its timestamp | T2 = the change in V that move caused (impact) | T3 = the situation AFTER it (leader_after)",
  "t3_definition": "leader_after = band of V immediately AFTER the move (landlord if V>0.55, farmers if V<0.45, else equal). Unified tier semantics: T1 = the event, T2 = the change in V it caused, T3 = the resulting situation.",
  "impact_eps": 0.034,
  "leader_band": 0.05,
  "thresholds": "FIXED across every case: reject or re-select a case, never re-tune eps for it, or macro_acc stops being comparable across the corpus",
  "abstention": "a row whose label is within 2 sigma of its band boundary carries null on that tier and is NOT scored there; it is still a T1 event. The model cannot tell which rows those are, so it must answer every row - abstention removes undecidable labels from the numerator, it does not make the task easier.",
  "event_rule": "every move that plays >=1 card; passes are shown on screen but never reported",
  "move_sec": 6.0,
  "leadin_sec": 12.0,
  "resolution": "1280x720",
  "distribution": {
    "tense": 7,
    "blowout": 7,
    "reversal": 6
  },
